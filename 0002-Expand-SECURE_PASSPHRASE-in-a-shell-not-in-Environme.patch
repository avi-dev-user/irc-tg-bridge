From 4bafaaebbe346ff71c06e0b64f4b1793cc1b8503 Mon Sep 17 00:00:00 2001
From: Avi <Avi@yemot.com>
Date: Wed, 19 Aug 2026 00:12:29 +0300
Subject: [PATCH 2/2] Expand SECURE_PASSPHRASE in a shell, not in Environment=

systemd performs no variable expansion in Environment=, so WeeChat received the
literal string "${SECURE_PASSPHRASE}" as its passphrase. Nothing looks wrong
because the secured data is then encrypted under that same literal and
round-trips - until someone edits the unit or the env file, at which point
sec.conf can no longer be decrypted and every SASL login fails.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 deploy/weechat-headless.service | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/deploy/weechat-headless.service b/deploy/weechat-headless.service
index 7009ea8..8219e31 100644
--- a/deploy/weechat-headless.service
+++ b/deploy/weechat-headless.service
@@ -6,10 +6,16 @@ Wants=network-online.target
 [Service]
 Type=simple
 # Optional secrets (leading '-': missing file is not an error). Holds
-# WEECHAT_PASSPHRASE once IRC servers with saved passwords exist.
+# SECURE_PASSPHRASE, which unlocks WeeChat's encrypted secured data.
 EnvironmentFile=-/etc/irc-tg-bridge/env
-Environment=WEECHAT_PASSPHRASE=${SECURE_PASSPHRASE}
-ExecStart=/usr/bin/weechat-headless --dir /var/lib/irc-tg-bridge/weechat
+# systemd does NOT expand variables in Environment=, so the old
+# `Environment=WEECHAT_PASSPHRASE=${SECURE_PASSPHRASE}` handed WeeChat the
+# literal string. It round-trips (the data gets encrypted under that same
+# literal) and so hides the bug until someone edits either file. A shell does
+# the expansion instead. Migrating an install that ran the old line: before
+# switching, run `/secure passphrase <the real SECURE_PASSPHRASE>` in the
+# running WeeChat to re-encrypt sec.conf, or it can no longer be decrypted.
+ExecStart=/bin/sh -c 'WEECHAT_PASSPHRASE="$SECURE_PASSPHRASE" exec /usr/bin/weechat-headless --dir /var/lib/irc-tg-bridge/weechat'
 Restart=always
 RestartSec=5
 
